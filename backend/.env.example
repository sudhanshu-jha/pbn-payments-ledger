DJANGO_SETTINGS_MODULE=pbn_payments.settings.local
CELERY_BROKER_URL=amqp://broker:5672//
REDIS_URL=redis://result:6379
# This project requires Postgres (row locks, the append-only trigger and a partial
# unique index). The default below matches docker-compose.yml; for a local Postgres
# change the host to localhost. SQLite is not supported.
DATABASE_URL=postgres://pbn_payments:password@db:5432/pbn_payments

## Label shown in the Django admin header to make the active environment explicit.
ADMIN_ENVIRONMENT_LABEL=Local
ADMIN_ENVIRONMENT_COLOR=#111827
ADMIN_ENVIRONMENT_BACKGROUND_COLOR=#f59e0b

## Payment processor integration (placeholders — generate real values per environment)
# HMAC-SHA256 key shared with the processor for X-Processor-Signature
PROCESSOR_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
# Where the simulated processor delivers webhooks. Inside docker compose the
# backend service is reachable as "backend"; locally use localhost.
PROCESSOR_WEBHOOK_URL=http://backend:8000/webhooks/processor
